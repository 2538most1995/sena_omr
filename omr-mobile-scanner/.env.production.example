SDL_CURRENT_TERM=1/2569
SDL_DISTRICT_ID=1

# Read DB_* from ../../SDL_school/laravel-app/.env on the same Plesk account.
# This avoids duplicating production credentials in the OMR folder.
OMR_USE_LARAVEL_DB_ENV=1
OMR_LISTEN_PORT=18080

# Optional explicit path if SDL_school is stored elsewhere.
# SDL_LARAVEL_ENV=/absolute/path/to/SDL_school/laravel-app/.env
