SDL_CURRENT_TERM=1/2569
SDL_DISTRICT_ID=1

# Read subjects and student rosters through the production SDL_school API.
SDL_SCHOOL_BASE_URL=https://krumost.com/SDL_school
SDL_SCHOOL_TOKEN=
SDL_SCHOOL_SUBJECTS_PATH=/api/v1/integrations/student-data/subjects
SDL_SCHOOL_GROUPS_PATH=/api/v1/integrations/student-data/subjects/{subject_code}/class-groups
SDL_SCHOOL_GROUP_STUDENTS_PATH=/api/v1/integrations/student-data/class-groups/{group_id}/students
SDL_SCHOOL_SUBJECT_STUDENTS_PATH=/api/v1/integrations/student-data/subjects/{subject_code}/students

# Keep direct database access disabled; production data must come from the API.
OMR_USE_LARAVEL_DB_ENV=0
OMR_LISTEN_PORT=18080
