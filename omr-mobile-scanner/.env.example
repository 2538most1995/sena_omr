SDL_CURRENT_TERM=1/2569
SDL_DISTRICT_ID=1

# แนะนำสำหรับเครื่อง MAMP ที่มีฐานข้อมูล SDL_school อยู่แล้ว
SDL_MYSQL_HOST=127.0.0.1
SDL_MYSQL_PORT=8889
SDL_MYSQL_DATABASE=sena_school_db
SDL_MYSQL_USER=root
SDL_MYSQL_PASSWORD=

# ทางเลือก: API ภายนอกที่รองรับรายวิชา กลุ่มเรียน รายชื่อ และการรับคะแนน
# SDL_SCHOOL_BASE_URL=https://your-sdl-school.example
# SDL_SCHOOL_TOKEN=sdl_student_...

# กำหนด path เหล่านี้เมื่อ API ภายนอกรองรับจริงเท่านั้น
# SDL_SCHOOL_SUBJECTS_PATH=/api/v1/integrations/student-data/subjects
# SDL_SCHOOL_GROUPS_PATH=/api/v1/integrations/student-data/subjects/{subject_code}/class-groups
# SDL_SCHOOL_GROUP_STUDENTS_PATH=/api/v1/integrations/student-data/class-groups/{group_id}/students
# SDL_SCHOOL_SCORES_PATH=/api/v1/integrations/student-data/scores

# Dedicated backend listen port. Do not use OMR_PORT on Plesk because the
# hosting runtime may inject it for an unrelated application service.
OMR_LISTEN_PORT=18080
