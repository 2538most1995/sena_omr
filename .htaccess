Options -Indexes
DirectoryIndex index.html

# Never expose application source, runtime data, credentials, logs, or deploy
# archives when this directory is served directly by Apache/Plesk.
<FilesMatch "(?i)(^\.|\.(?:pyc?|sh|sqlite3(?:-.*)?|log|pid|zip|gz|sha256|txt|md|json|conf)$)">
    Require all denied
</FilesMatch>

RewriteEngine On

# Reject direct browser requests for private application directories. Internal
# rewrites to frontend assets are still allowed because THE_REQUEST is unchanged.
RewriteCond %{THE_REQUEST} "\s/+(?:[^?\s]*/)?omr-mobile-scanner/(?:backend|scripts|tests|mamp|runtime-libs|\.run|\.tools|\.venv|\.python|\.runtime-libs)(?:[/\s?])" [NC]
RewriteRule ^ - [R=404,L]

# Keep the public application at /sena_omr while the source stays in its
# existing omr-mobile-scanner directory.
RewriteRule ^api/(.*)$ http://127.0.0.1:8000/api/$1 [P,L,QSA]
RewriteRule ^assets/(.*)$ omr-mobile-scanner/frontend/$1 [L]
RewriteRule ^sw\.js$ omr-mobile-scanner/frontend/sw.js [L]
RewriteRule ^$ omr-mobile-scanner/frontend/index.html [L]

# Client-side routes fall back to the application shell. Existing files and
# directories remain directly accessible.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ omr-mobile-scanner/frontend/index.html [L]
